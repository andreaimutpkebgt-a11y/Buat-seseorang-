<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shape of My Heart - Backstreet Boys</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #0d1117;
            color: #e6edf3;
            font-family: 'Consolas', 'Courier New', Courier, monospace;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .terminal-container {
            width: 100%;
            max-width: 600px;
            background-color: #161b22;
            border: 1px solid #30363d;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            overflow: hidden;
        }

        .terminal-header {
            background-color: #21262d;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #30363d;
        }

        .window-dots {
            display: flex;
            gap: 8px;
        }

        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }

        .dot.red { background-color: #ff5f56; }
        .dot.yellow { background-color: #ffbd2e; }
        .dot.green { background-color: #27c93f; }

        .terminal-title {
            font-size: 13px;
            color: #8b949e;
        }

        .terminal-body {
            padding: 20px;
            min-height: 350px;
            max-height: 480px;
            overflow-y: auto;
            font-size: 15px;
            line-height: 1.6;
        }

        .header-text {
            color: #58a6ff;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .line {
            margin-bottom: 6px;
            color: #f0f6fc;
        }

        .cursor {
            display: inline-block;
            width: 8px;
            height: 16px;
            background-color: #58a6ff;
            margin-left: 2px;
            vertical-align: middle;
            animation: blink 0.8s infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        .controls {
            margin-top: 20px;
            text-align: center;
        }

        .btn-start {
            background-color: #238636;
            color: #ffffff;
            border: none;
            padding: 10px 24px;
            font-size: 14px;
            font-family: inherit;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
        }

        .btn-start:disabled {
            background-color: #343942;
            color: #6e7681;
            cursor: not-allowed;
        }
    </style>
</head>
<body>

    <div class="terminal-container">
        <div class="terminal-header">
            <div class="window-dots">
                <div class="dot red"></div>
                <div class="dot yellow"></div>
                <div class="dot green"></div>
            </div>
            <div class="terminal-title">lirik.html — Shape of My Heart</div>
            <div></div>
        </div>
        <div class="terminal-body" id="terminal">
            <div class="header-text">--- Memutar: Shape of My Heart ---</div>
            <div id="output"></div><span class="cursor" id="cursor"></span>
        </div>
    </div>

    <div class="controls">
        <button class="btn-start" id="startBtn" onclick="startLyrics()">▶ Putar Lirik</button>
    </div>

    <script>
        const lyrics = [
            "Hmm, yeah, yeah",
            "Baby, please don't go",
            "Lookin' back on the things I've done",
            "I was tryin' to be someone",
            "I played my part, kept you in the dark",
            "Now let me show you the shape of my heart",
            "",
            "Sadness is my line",
            "That's the story of my life",
            "Baby, please don't go",
            "Lookin' back on the things I've done",
            "I never wanna play the same old part",
            "Keep you in the dark",
            "Now let me show you the shape of my heart",
            "",
            "I'm lookin' back on things I've done",
            "I never wanna play the same old part",
            "Keep you in the dark (keep you in the dark)",
            "Now let me show you the shape of my heart",
            "",
            "Sadness is my line",
            "That's the story of my life",
            "Baby, please don't go",
            "Lookin' back on the things I've done",
            "I never wanna play the same old part",
            "Keep you in the dark",
            "Now let me show you the shape of my heart",
            "",
            "Show you the shape of my heart",
            "I'm lookin' back on things I've done",
            "I never wanna play the same old part",
            "Keep you in the dark",
            "Now let me show you the shape of my heart",
            "",
            "Show you the shape of my heart",
            "Show you the shape of my heart",
            "Now let me show you the shape of my heart",
            "",
            "--- TAMAT ---"
        ];

        const outputDiv = document.getElementById('output');
        const startBtn = document.getElementById('startBtn');
        const terminalBody = document.getElementById('terminal');

        let isRunning = false;

        async function startLyrics() {
            if (isRunning) return;
            isRunning = true;
            startBtn.disabled = true;
            outputDiv.innerHTML = '';

            for (let i = 0; i < lyrics.length; i++) {
                const line = lyrics[i];
                const lineElem = document.createElement('div');
                lineElem.className = 'line';
                outputDiv.appendChild(lineElem);

                for (let j = 0; j < line.length; j++) {
                    lineElem.textContent += line[j];
                    terminalBody.scrollTop = terminalBody.scrollHeight;
                    await sleep(60); // Kecepatan ketik (ms)
                }

                if (line.includes("shape of my heart") || line === "") {
                    await sleep(1200);
                } else {
                    await sleep(600);
                }
            }

            startBtn.disabled = false;
            isRunning = false;
        }

        function sleep(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }
    </script>
</body>
  </html>
  
